{
  "schemaVersion": "2.1",
  "meta": {
    "id": "deck-vanilla-scaffold",
    "slug": "vanilla-scaffold",
    "title": "Framework-Agnostic Scaffold",
    "description": "Second reference implementation: an editable editor + presenter built with plain DOM and Web Components, no framework, passing every DeckForge gate (schema, strict layout, content, motion, output contract, scrollbars).",
    "language": "en",
    "audience": "Engineers who want an editable deck without a component framework",
    "objective": "Demonstrate that the editable-deck output contract is framework-agnostic.",
    "templateId": "feature-deep-dive",
    "authors": ["DeckForge Studio"],
    "tags": ["vanilla", "web-components", "framework-agnostic", "engineering"],
    "createdAt": "2026-08-07T00:00:00.000Z",
    "updatedAt": "2026-08-07T00:00:00.000Z"
  },
  "canvas": {
    "aspectRatio": "16:9",
    "width": 1600,
    "height": 900,
    "safeMargin": 64,
    "grid": 8,
    "responsiveMode": "hybrid",
    "layoutMode": "semantic-slots"
  },
  "theme": {
    "id": "editorial-cream",
    "overrides": {}
  },
  "presentation": {
