  "assets": [],
  "slides": [
    {
      "id": "s1",
      "title": "The page you ship has a weight",
      "layout": "title-hero",
      "blocks": [
        {
          "id": "b1",
          "type": "text",
          "content": "WEB PERFORMANCE · A DATA STORY",
          "style": { "variant": "kicker" },
          "alt": "",
          "sourceIds": [],
          "slot": "kicker",
          "positionMode": "slot"
        },
        {
          "id": "b2",
          "type": "heading",
          "content": "The page you ship has a weight.",
          "style": { "level": 1 },
          "alt": "",
          "sourceIds": [],
          "slot": "title",
          "positionMode": "slot"
        },
        {
          "id": "b3",
          "type": "text",
          "content": "Every byte you ship travels over a network, costs energy to serve and render, and competes with your user's attention. This talk is about one number that controls all of it: the median page weight.",
          "style": {},
          "alt": "",
          "sourceIds": ["src-httparchive"],
          "slot": "subtitle",
          "positionMode": "slot"
        },
        {
          "id": "b4",
          "type": "text",
          "content": "A practical guide to measuring, budgeting, and shipping lighter pages.",
          "style": { "variant": "meta" },
          "alt": "",
          "sourceIds": [],
          "slot": "meta",
          "positionMode": "slot"
        },
        {
          "id": "b5",
          "type": "chart",
          "content": {
            "type": "bar",
            "title": "Median desktop page weight",
            "unit": "MB",
            "values": [
              { "label": "2016", "value": 1.6 },
              { "label": "2018", "value": 1.9 },
              { "label": "2020", "value": 2.1 },
              { "label": "2022", "value": 2.3 },
              { "label": "2024", "value": 2.4 }
            ],
            "highlightIndex": 4,
            "summary": "Median desktop page weight grew from about 1.6 megabytes in 2016 to 2.4 megabytes in 2024."
          },
          "style": {},
          "alt": "Bar chart showing median desktop page weight rising from 1.6 MB in 2016 to 2.4 MB in 2024.",
          "sourceIds": ["src-httparchive"],
          "slot": "visual",
          "positionMode": "slot"
        }
      ],
      "speakerNotes": "Open with the physical reality behind every page load: bytes, networks, energy, and attention. The median page is not a small file — it is a 2.4 MB download that has to happen before a single sentence is readable.",
      "sources": ["src-httparchive"],
      "interactions": [],
      "density": "low",
      "layoutBindings": [
        { "slot": "kicker", "blockIds": ["b1"], "flow": "stack", "gap": 8 },
        { "slot": "title", "blockIds": ["b2"], "flow": "stack", "gap": 8 },
        { "slot": "subtitle", "blockIds": ["b3"], "flow": "stack", "gap": 8 },
        { "slot": "meta", "blockIds": ["b4"], "flow": "stack", "gap": 8 },
        { "slot": "visual", "blockIds": ["b5"], "flow": "stack", "gap": 8 }
      ]
    },
    {
      "id": "s2",
      "title": "The median page weighs 2.4 MB",
      "layout": "big-number",
      "blocks": [
        {
          "id": "b6",
          "type": "text",
          "content": "MEDIAN TOTAL PAGE WEIGHT, DESKTOP",
          "style": { "variant": "kicker" },
          "alt": "",
          "sourceIds": [],
          "slot": "context",
          "positionMode": "slot"
        },
        {
          "id": "b7",
          "type": "metric",
          "content": {
            "value": "2.4 MB",
            "label": "median desktop page weight in 2024",
            "delta": "+50% since 2016"
          },
          "style": {},
          "alt": "",
          "sourceIds": ["src-httparchive"],
          "slot": "metric",
          "positionMode": "slot"
        },
        {
          "id": "b8",
          "type": "heading",
          "content": "Half of it is images, a quarter is JavaScript.",
          "style": { "level": 3 },
          "alt": "",
          "sourceIds": ["src-webalmanac"],
          "slot": "meaning",
          "positionMode": "slot"
        },
        {
          "id": "b9",
          "type": "text",
          "content": "Images and JavaScript together account for roughly three quarters of the median page's transfer size — and most of its energy cost.",
          "style": {},
          "alt": "",
          "sourceIds": ["src-webalmanac"],
          "slot": "meaning",
          "positionMode": "slot"
        },
        {
          "id": "b10",
          "type": "citation",
          "content": "HTTP Archive · Web Almanac, median desktop page weight, 2016–2024 (approximate).",
          "style": {},
          "alt": "",
          "sourceIds": ["src-httparchive", "src-webalmanac"],
          "slot": "footer",
          "positionMode": "slot"
        }
      ],
      "speakerNotes": "One number frames the whole talk. Everything that follows is a consequence of this number: network cost, device energy, rendering time, and cognitive load.",
      "sources": ["src-httparchive", "src-webalmanac"],
      "interactions": [],
      "density": "low",
      "layoutBindings": [
        { "slot": "context", "blockIds": ["b6"], "flow": "stack", "gap": 8 },
        { "slot": "metric", "blockIds": ["b7"], "flow": "stack", "gap": 8 },
        { "slot": "meaning", "blockIds": ["b8", "b9"], "flow": "stack", "gap": 12 },
        { "slot": "footer", "blockIds": ["b10"], "flow": "stack", "gap": 8 }
      ]
    },
    {
      "id": "s3",
      "title": "Pages did not get heavier on purpose",
      "layout": "chart-focus",
      "blocks": [
        {
          "id": "b11",
          "type": "text",
          "content": "FIVE YEARS OF TREND",
          "style": { "variant": "kicker" },
          "alt": "",
          "sourceIds": [],
          "slot": "kicker",
          "positionMode": "slot"
        },
        {
          "id": "b12",
          "type": "heading",
          "content": "Pages did not get heavier on purpose.",
          "style": { "level": 1 },
          "alt": "",
          "sourceIds": [],
          "slot": "title",
          "positionMode": "slot"
        },
        {
          "id": "b13",
          "type": "chart",
          "content": {
            "type": "bar",
            "title": "Median desktop page weight, by year",
            "unit": "MB",
            "values": [
              { "label": "2016", "value": 1.6 },
              { "label": "2017", "value": 1.7 },
              { "label": "2018", "value": 1.9 },
              { "label": "2019", "value": 2.0 },
              { "label": "2020", "value": 2.1 },
              { "label": "2021", "value": 2.2 },
              { "label": "2022", "value": 2.3 },
              { "label": "2023", "value": 2.4 },
              { "label": "2024", "value": 2.4 }
            ],
            "highlightIndex": 8,
            "summary": "Median desktop page weight rose nearly every year, from 1.6 MB in 2016 to 2.4 MB in 2024."
          },
          "style": {},
          "alt": "Bar chart of median desktop page weight from 2016 to 2024, climbing steadily to 2.4 megabytes.",
          "sourceIds": ["src-httparchive"],
          "slot": "chart",
          "positionMode": "slot"
        },
        {
          "id": "b14",
          "type": "text",
          "content": "No single team made this happen. It is the aggregate of a thousand small, individually reasonable additions.",
          "style": { "variant": "callout" },
          "alt": "",
          "sourceIds": [],
          "slot": "annotation",
          "positionMode": "slot"
        },
        {
          "id": "b15",
          "type": "citation",
          "content": "HTTP Archive, median desktop page weight by year (approximate).",
          "style": {},
          "alt": "",
          "sourceIds": ["src-httparchive"],
          "slot": "source",
          "positionMode": "slot"
        }
      ],
      "speakerNotes": "Nobody adds 'more megabytes' to their backlog. Weight accretes one dependency, one hero image, one tracking script at a time. This is why the fix must be a measurable budget, not a series of individual decisions.",
      "sources": ["src-httparchive"],
      "interactions": [],
      "density": "medium",
      "layoutBindings": [
        { "slot": "kicker", "blockIds": ["b11"], "flow": "stack", "gap": 8 },
        { "slot": "title", "blockIds": ["b12"], "flow": "stack", "gap": 8 },
        { "slot": "chart", "blockIds": ["b13"], "flow": "stack", "gap": 8 },
        { "slot": "annotation", "blockIds": ["b14"], "flow": "stack", "gap": 8 },
        { "slot": "source", "blockIds": ["b15"], "flow": "stack", "gap": 8 }
      ]
    },
    {
      "id": "s4",
      "title": "Images and JavaScript carry most of the cost",
      "layout": "split-visual",
      "blocks": [
        {
          "id": "b16",
          "type": "text",
          "content": "ANATOMY OF A MEDIAN PAGE",
          "style": { "variant": "kicker" },
          "alt": "",
          "sourceIds": [],
          "slot": "kicker",
          "positionMode": "slot"
        },
        {
          "id": "b17",
          "type": "heading",
          "content": "Images and JavaScript carry most of the cost.",
          "style": { "level": 1 },
          "alt": "",
          "sourceIds": [],
          "slot": "title",
          "positionMode": "slot"
        },
        {
          "id": "b18",
          "type": "chart",
          "content": {
            "type": "bar-horizontal",
            "title": "Share of median page weight",
            "unit": "%",
            "values": [
              { "label": "Images", "value": 50 },
              { "label": "JavaScript", "value": 25 },
              { "label": "Fonts", "value": 7 },
              { "label": "CSS", "value": 4 },
              { "label": "Video & other", "value": 14 }
            ],
            "highlightIndex": 0,
            "summary": "Images are about half of median page weight, JavaScript about a quarter, with fonts, CSS, and other resources making up the rest."
          },
          "style": {},
          "alt": "Horizontal bar chart showing images at fifty percent of page weight, JavaScript twenty-five percent, and the rest split among fonts, CSS, and video.",
          "sourceIds": ["src-webalmanac"],
          "slot": "visual",
          "positionMode": "slot"
        },
        {
          "id": "b19",
          "type": "bullets",
          "content": [
            "Images dominate bytes because most are shipped larger than the rendered size.",
            "JavaScript adds weight twice: download time, then parse and execute time.",
            "Fonts and CSS feel small, but they block first paint."
          ],
          "style": {},
          "alt": "",
          "sourceIds": ["src-webalmanac"],
          "slot": "interpretation",
          "positionMode": "slot"
        }
      ],
      "speakerNotes": "Point at the two bars that matter. Images are a delivery problem; JavaScript is a delivery plus execution problem. Fonts and CSS are small but block rendering, which makes them feel expensive out of proportion to their bytes.",
      "sources": ["src-webalmanac"],
      "interactions": [],
      "density": "medium",
      "layoutBindings": [
        { "slot": "kicker", "blockIds": ["b16"], "flow": "stack", "gap": 8 },
        { "slot": "title", "blockIds": ["b17"], "flow": "stack", "gap": 8 },
        { "slot": "visual", "blockIds": ["b18"], "flow": "stack", "gap": 8 },
        { "slot": "interpretation", "blockIds": ["b19"], "flow": "stack", "gap": 10 }
      ]
    }
  ],
