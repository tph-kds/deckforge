{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deckforge.dev/schemas/skill-eval-result.schema.json",
  "title": "DeckForge Skill Eval Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "condition", "caseId", "score", "assertions", "runtimeMs", "contextTokens", "failures", "runAt"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "condition": { "enum": ["baseline", "current", "candidate"] },
    "caseId": { "type": "string" },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "assertions": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "runtimeMs": { "type": "integer", "minimum": 0 },
    "contextTokens": { "type": "integer", "minimum": 0 },
    "failures": { "type": "array", "items": { "type": "string" } },
    "runAt": { "type": "string", "format": "date-time" }
  }
}
