{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deckforge.dev/schemas/capability-evidence.schema.json",
  "title": "DeckForge Capability Evidence",
  "description": "One executed-evidence entry produced by a trusted runner (Playwright/export/browser). Evidence must be generated by a runner at a known commit; a manual declaration or a source test file is not evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "testId", "status", "commit", "runId",
    "artifact", "artifactSha256", "startedAt", "finishedAt"
  ],
  "properties": {
    "kind": { "enum": ["playwright", "export", "browser", "accessibility"] },
    "testId": { "type": "string", "minLength": 1 },
    "status": { "const": "passed" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "runId": { "type": "string", "minLength": 1 },
    "browser": { "type": "string", "default": "chromium" },
    "viewport": { "type": "string", "pattern": "^[0-9]+x[0-9]+$", "default": "1440x900" },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^|/)tests?/|_spec\\.ts$|\\.test\\.ts$|\\.spec\\.ts$" }
    },
    "artifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" }
  }
}
